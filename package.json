{
  "name": "ompstack",
  "version": "0.3.4",
  "description": "Risk-routed engineering workflow for OhMyPi",
  "files": [
    "agents",
    "commands",
    "docs",
    "extensions",
    "examples",
    "scripts",
    "policy",
    "skills",
    "NOTICE.md",
    "third_party/PSTACK_LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun scripts/validate-plugin.mjs && tsc --project tsconfig.plugin.json",
    "test": "bun test tests",
    "prepublishOnly": "bun run check && bun test tests && npm pack --dry-run"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.2.0",
    "typescript": "^5.9.3"
  },
  "omp": {
    "extensions": [
      "./extensions/ompstack-runtime.ts"
    ]
  }
}
