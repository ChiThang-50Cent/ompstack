{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement-reconstruction-output-schemas.json",
  "requirementReconstructionV1": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": { "const": 1 },
      "status": { "enum": ["COMPLETE", "INSUFFICIENT_EVIDENCE"] },
      "requirements": { "$ref": "#/requirementReconstructionV1/$defs/requirements" },
      "derived_requirements": {
        "type": "array",
        "items": { "$ref": "#/requirementReconstructionV1/$defs/derivedRequirement" }
      },
      "repo_invariants": {
        "type": "array",
        "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceBoundStatement" }
      },
      "affected_surfaces": {
        "type": "array",
        "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceBoundStatement" }
      },
      "unknowns": {
        "type": "array",
        "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceBoundStatement" }
      },
      "evidence": {
        "type": "array",
        "items": { "$ref": "#/requirementReconstructionV1/$defs/evidence" }
      }
    },
    "required": [
      "schema_version",
      "status",
      "requirements",
      "derived_requirements",
      "repo_invariants",
      "affected_surfaces",
      "unknowns",
      "evidence"
    ],
    "allOf": [
      {
        "if": { "properties": { "status": { "const": "INSUFFICIENT_EVIDENCE" } } },
        "then": {
          "properties": {
            "requirements": { "maxItems": 0 },
            "derived_requirements": { "maxItems": 0 },
            "unknowns": { "minItems": 1 }
          }
        }
      },
      {
        "if": { "properties": { "status": { "const": "COMPLETE" } } },
        "then": { "properties": { "requirements": { "minItems": 1 } } }
      }
    ],
    "$defs": {
      "evidenceReference": {
        "type": "string",
        "minLength": 1
      },
      "requirements": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requirement": { "type": "string", "minLength": 1 },
            "source_evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceReference" }
            }
          },
          "required": ["requirement", "source_evidence"]
        }
      },
      "derivedRequirement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement": { "type": "string", "minLength": 1 },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceReference" }
          },
          "derivation": { "type": "string", "minLength": 1 }
        },
        "required": ["requirement", "source_evidence", "derivation"]
      },
      "evidenceBoundStatement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/requirementReconstructionV1/$defs/evidenceReference" }
          }
        },
        "required": ["statement", "source_evidence"]
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["user_turn", "issue", "spec", "artifact", "repository_contract"] },
          "locator": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "kind", "locator", "excerpt"]
      }
    }
  },
  "requirementReconstructionBReviewerEnvelopeV1": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reconstruction": { "$ref": "#/requirementReconstructionV1" },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "finding_id": { "type": "string", "minLength": 1 },
            "finding": { "type": "string", "minLength": 1 },
            "blocking": { "type": "boolean" },
            "source_evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "derivation": { "type": "string", "minLength": 1 }
          },
          "required": ["finding_id", "finding", "blocking", "source_evidence"]
        }
      },
      "closeout": {
        "$ref": "#/requirementReconstructionV1/$defs/evidenceBoundStatement"
      }
    },
    "required": ["reconstruction", "findings"]
  }
}
