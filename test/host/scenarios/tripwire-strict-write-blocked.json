{
  "name": "tripwire-strict-write-blocked",
  "mode": "strict",
  "prompt": "the sidebar lags when I scroll",
  "rules": [
    {
      "id": "main",
      "steps": [
        {
          "tool": "write",
          "args": {
            "path": "lib.js",
            "content": "export const x = 1;\n"
          }
        },
        {
          "final": "stopped"
        }
      ]
    }
  ],
  "assert": [
    {
      "type": "systemContains",
      "rule": "main",
      "text": "Edits without a run are blocked"
    },
    {
      "type": "toolResultContains",
      "rule": "main",
      "text": "open a run before editing"
    },
    {
      "type": "jsonlWhere",
      "file": ".omp/pstack/runs/session-events.jsonl",
      "where": {
        "type": "unengaged_write_blocked",
        "data.tool": "write"
      }
    }
  ]
}
