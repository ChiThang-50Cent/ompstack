{
  "schemaVersion": 1,
  "changedLinesScope": "code-files-only",
  "generatedPathPatterns": [
    "(?:^|/)generated/",
    "\\.generated\\.",
    "\\.gen\\."
  ],
  "codePathPatterns": [
    "\\.(?:go|py|js|jsx|mjs|cjs|ts|tsx|mts|cts|java)$"
  ],
  "nonCodePathPatterns": [
    "^(?:docs/|CHANGELOG\\.md$|NOTICE\\.md$|README\\.md$|\\.omp-plugin/marketplace\\.json$)"
  ],
  "packageRootMarkers": [
    "package.json",
    "go.mod",
    "pyproject.toml",
    "setup.py",
    "pom.xml",
    "build.gradle",
    "build.gradle.kts"
  ],
  "knownPathPatterns": [
    "^(?:agents|commands|docs|examples|extensions|policy|scripts|skills|tests)/",
    "^(?:CHANGELOG\\.md|NOTICE\\.md|README\\.md|package(?:-lock)?\\.json)$",
    "^(?:\\.omp(?:-plugin)?/|\\.gitignore$|bun\\.lock$|tsconfig\\.plugin\\.json$)"
  ],
  "knownFlags": [
    "touchesAuth",
    "touchesAuthorization",
    "touchesCryptoOrSecrets",
    "touchesTenantIsolation",
    "touchesMoneyMovement",
    "touchesMigration",
    "destructiveMigration",
    "touchesRuntimeConfig",
    "touchesPublicAPI",
    "touchesPersistence",
    "touchesConcurrency",
    "touchesGeneratedCode",
    "touchesExposedParser"
  ],
  "overlayHeuristics": {
    "distinctive": [
      { "pattern": "auth|login|session|token|credential", "flags": ["touchesAuth"] },
      { "pattern": "crypto|cipher|secret|key|hash|tls|ssl|cert", "flags": ["touchesCryptoOrSecrets"] },
      { "pattern": "migrat|schema|alembic", "flags": ["touchesMigration"] },
      { "pattern": "permission|acl|role|policy", "flags": ["touchesAuthorization"] },
      { "pattern": "config|settings|env", "flags": ["touchesRuntimeConfig"] },
      { "pattern": "parser|parse|decode|deserial|unmarshal", "flags": ["touchesExposedParser"] },
      { "pattern": "concurren|thread|async|pool|lock|mutex", "flags": ["touchesConcurrency"] },
      { "pattern": "store|storage|db|database|persist|cache", "flags": ["touchesPersistence"] },
      { "pattern": "shell|exec|command|spawn", "flags": ["touchesExposedParser"] }
    ],
    "common": [
      { "pattern": "path|file|upload|dir", "flags": ["touchesPersistence"] },
      { "pattern": "proxy|redirect|url|http|request|header|cookie", "flags": ["touchesPublicAPI"] },
      { "pattern": "sql|query|repositor", "flags": ["touchesPersistence"] },
      { "pattern": "user|admin|tenant|access", "flags": ["touchesAuthorization"] },
      { "pattern": "render|template|eval|json|yaml", "flags": ["touchesExposedParser"] }
    ]
  },
  "pathRules": [
    {
      "id": "extension-runtime",
      "pathPattern": "^extensions/",
      "flags": ["touchesRuntimeConfig"]
    },
    {
      "id": "package-runtime",
      "pathPattern": "^package\\.json$",
      "flags": ["touchesRuntimeConfig"]
    }
  ]
}
