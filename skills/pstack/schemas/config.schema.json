{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pstack-omp configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaultMode": {
      "enum": [
        "off",
        "auto",
        "strict"
      ]
    },
    "writeAuditFiles": {
      "type": "boolean"
    },
    "enforceIndependentVerifier": {
      "type": "boolean"
    },
    "preferCrossFamilyVerifier": {
      "type": "boolean"
    },
    "requireEvidenceForPass": {
      "type": "boolean"
    },
    "requireArtifactFingerprint": {
      "type": "boolean"
    },
    "maxPolicyCharacters": {
      "type": "integer",
      "minimum": 1000
    },
    "maxStopGateBlocks": {
      "type": "integer",
      "minimum": 0
    },
    "auditDirectory": {
      "type": "string",
      "minLength": 1
    },
    "fingerprintIgnore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maxWorkspaceFiles": {
      "type": "integer",
      "minimum": 1
    },
    "maxHashedFileBytes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
