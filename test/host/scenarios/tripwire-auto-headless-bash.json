{
  "name": "tripwire-auto-headless-bash",
  "mode": "auto",
  "prompt": "the sidebar lags when I scroll",
  "expectExit": 3,
  "rules": [
    {
      "id": "main",
      "steps": [
        {
          "tool": "bash",
          "args": {
            "command": "for i in $(seq 1 30); do echo \"export const v$i = $i;\"; done > lib.js && echo changed >> README.md"
          }
        },
        {
          "final": "Done, fixed it."
        }
      ]
    }
  ],
  "assert": [
    {
      "type": "systemContains",
      "rule": "main",
      "text": "may stay direct"
    },
    {
      "type": "outputContains",
      "text": "without a pstack run"
    },
    {
      "type": "outputContains",
      "text": "Exit status 3 signals unverified work"
    },
    {
      "type": "jsonlWhere",
      "file": ".omp/pstack/runs/session-events.jsonl",
      "where": {
        "type": "unengaged_change",
        "data.headless": true
      }
    }
  ]
}
