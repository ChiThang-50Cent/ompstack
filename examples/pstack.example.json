{
  "defaultMode": "auto",
  "writeAuditFiles": true,
  "enforceIndependentVerifier": true,
  "preferCrossFamilyVerifier": true,
  "requireEvidenceForPass": true,
  "requireArtifactFingerprint": true,
  "maxPolicyCharacters": 8000,
  "maxStopGateBlocks": 0,
