{
  "name": "tripwire-strict-stop-blocked",
  "mode": "strict",
  "prompt": "the sidebar lags when I scroll",
  "expectExit": 3,
  "rules": [
    {
      "id": "main",
      "steps": [
        {
          "tool": "bash",
          "args": {
            "command": "for i in $(seq 1 30); do echo \"export const v$i = $i;\"; done > lib.js && echo changed >> README.md"
          }
        },
        {
          "final": "Done, fixed it."
        }
      ]
    }
  ],
  "assert": [
    {
      "type": "ruleHit",
      "rule": "main",
      "min": 4
    },
    {
      "type": "jsonlWhere",
      "file": ".omp/pstack/runs/session-events.jsonl",
      "where": {
        "type": "unengaged_stop_blocked"
      },
      "min": 2
    },
    {
      "type": "jsonlWhere",
      "file": ".omp/pstack/runs/session-events.jsonl",
      "where": {
        "type": "unengaged_change",
        "data.exitCode": 3
      }
    },
    {
      "type": "outputContains",
      "text": "changed 2 file(s) / 31 line(s) without a pstack run"
    }
  ]
}
